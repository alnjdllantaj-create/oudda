{
  "name": "oudda-content-creator-toolkit",
  "version": "1.0.0",
  "private": true,
  "description": "Oudda / عدّة — free bilingual (Arabic/French) toolkit and guides for content creators. 100% client-side, no paid APIs.",
  "scripts": {
    "prebuild": "node scripts/generate-meta.mjs",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify": "node scripts/verify-site.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify",
    "package": "python3 scripts/make-archive.py"
  },
  "dependencies": {
    "next": "16.2.6",
    "qrcode.react": "4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
